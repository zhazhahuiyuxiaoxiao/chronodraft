{
  "name": "chronodraft",
  "version": "0.1.1",
  "description": "Version control for writers — without learning Git.",
  "desktopName": "chronodraft",
  "main": "src/main.js",
  "author": "zhihao zhang",
  "homepage": "https://github.com/zhazhahuiyuxiaoxiao/chronodraft",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "ui:smoke": "node scripts/ui-smoke.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "pack": "npx --yes electron-builder@26.15.3 --dir --publish never",
    "dist:mac": "npx --yes electron-builder@26.15.3 --mac dmg zip --arm64 --publish never",
    "dist:win": "npx --yes electron-builder@26.15.3 --win nsis --publish never",
    "dist:linux": "npx --yes electron-builder@26.15.3 --linux AppImage --publish never",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/git-service.js && node --check src/renderer/app.js"
  },
  "devDependencies": {
    "electron": "^38.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "app.chronodraft.desktop",
    "productName": "ChronoDraft",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ChronoDraft"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
